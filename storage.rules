rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Templates (Hardware & MES deployment requirements) — read by any authed user.
    // Write/delete restricted to Instrumental employees (email gate).
    match /templates/{filename=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null
                           && request.auth.token.email.matches('.*@instrumental[.]com');
    }

    // Project uploads — read by any authed user (UI gates by per-project access).
    // Write/delete restricted to Instrumental employees ONLY (external/customer users
    // can VIEW project files but cannot upload/edit/delete).
    // Allowed types: PDF, Office (DOCX/XLSX/PPTX/DOC/XLS/PPT), images, text/CSV, .lbx (label files).
    match /uploads/{projectId}/{filename=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email.matches('.*@instrumental[.]com')
                   && request.resource.size < 50 * 1024 * 1024
                   && (
                     request.resource.contentType == 'application/pdf' ||
                     request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
                     request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' ||
                     request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation' ||
                     request.resource.contentType == 'application/msword' ||
                     request.resource.contentType == 'application/vnd.ms-excel' ||
                     request.resource.contentType == 'application/vnd.ms-powerpoint' ||
                     request.resource.contentType == 'application/octet-stream' ||
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType.matches('text/.*')
                   );
      allow delete: if request.auth != null
                    && request.auth.token.email.matches('.*@instrumental[.]com');
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
